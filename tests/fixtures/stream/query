#!/bin/bash
# Select the version written by the integration test.
set -Eeuo pipefail

: "${ADAPTER_DIR:?ADAPTER_DIR must be set and non-empty}"
: "${WORKSPACE:?WORKSPACE must be set and non-empty}"
: "${ARCHES:?ARCHES must be set and non-empty}"

VERSION=${TEST_VERSION:-$(cat "$ADAPTER_DIR/upstream-version")}

for ARCHITECTURE in $ARCHES; do
    printf '%s\t%s\n' "$VERSION" "$ARCHITECTURE"
done > "$WORKSPACE/targets.tsv"

RELEASE_DATE=${TEST_RELEASE_DATE:-2000-01-01T00:00:00Z}
printf '%s\n' "$RELEASE_DATE" > "$WORKSPACE/release-date"
