#!/bin/bash
# Create small, installable packages without downloading anything.
set -Eeuo pipefail

: "${ADAPTER_DIR:?ADAPTER_DIR must be set and non-empty}"
: "${WORKSPACE:?WORKSPACE must be set and non-empty}"
: "${MAINTAINER:?MAINTAINER must be set and non-empty}"
: "${BINARY_PACKAGES:?BINARY_PACKAGES must be set and non-empty}"
: "${PUBLISHER_STREAM:?PUBLISHER_STREAM must be set and non-empty}"
: "${BUILD_INPUTS_SHA256:?BUILD_INPUTS_SHA256 must be set and non-empty}"

VERSION="$1"
ARCHITECTURE="$2"
OUTPUT_DIR="$3"

if [[ "${TEST_FAIL_ARCH:-}" == "$ARCHITECTURE" ]]; then
    echo "Fixture build failed for $ARCHITECTURE" >&2
    exit 7
fi

for PACKAGE_NAME in $BINARY_PACKAGES; do
    PACKAGE_DIR="$WORKSPACE/package-$PACKAGE_NAME-$ARCHITECTURE"
    mkdir -p "$PACKAGE_DIR/DEBIAN"
    mkdir -p "$PACKAGE_DIR/usr/share/$PACKAGE_NAME"
    printf '%s\n' "$PUBLISHER_STREAM" > "$PACKAGE_DIR/usr/share/$PACKAGE_NAME/stream"

    cat > "$PACKAGE_DIR/DEBIAN/control" <<CONTROL
Package: $PACKAGE_NAME
Version: $VERSION
Architecture: $ARCHITECTURE
Maintainer: $MAINTAINER
Description: Empty integration fixture
X-Build-Inputs-SHA256: $BUILD_INPUTS_SHA256
X-Publisher-Stream: $PUBLISHER_STREAM
CONTROL

    OUTPUT_FILE="$OUTPUT_DIR/${PACKAGE_NAME}_${VERSION}_${ARCHITECTURE}.deb"
    dpkg-deb --build --root-owner-group "$PACKAGE_DIR" "$OUTPUT_FILE"
done
