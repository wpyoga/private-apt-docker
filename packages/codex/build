#!/bin/bash
set -Eeuo pipefail

: "${FRAMEWORK_DIR:?FRAMEWORK_DIR must be set and non-empty}"
source "$FRAMEWORK_DIR/lib/adapter/package.sh"

: "${ADAPTER_DIR:?ADAPTER_DIR must be set and non-empty}"
: "${WORKSPACE:?WORKSPACE must be set and non-empty}"
: "${PUBLISHER_STREAM:?PUBLISHER_STREAM must be set and non-empty}"
: "${BUILD_INPUTS_SHA256:?BUILD_INPUTS_SHA256 must be set and non-empty}"
: "${MAINTAINER:?MAINTAINER must be set and non-empty}"

PACKAGE_VERSION="$1"
ARCHITECTURE="$2"
OUTPUT_DIR="$3"
OUTPUT="$OUTPUT_DIR/codex-cli_${PACKAGE_VERSION}_${ARCHITECTURE}.deb"
SOURCE_DIR="$WORKSPACE/extract-$ARCHITECTURE"

check_member_types() {
    # Allow regular files (-), directories (d), symlinks (l), and hard links (h).
    # Escaping names keeps one archive entry per line, even for unusual names.
    tar --list --verbose --gzip --quoting-style=escape --file "$ARCHIVE_PATH" |
        awk '
            substr($0, 1, 1) !~ /^[-dlh]$/ {
                print "Unsupported archive entry type" > "/dev/stderr"
                exit 1
            }
        '
}

check_links() {
    local LINK_PATH RESOLVED_PATH

    while IFS= read -r -d '' LINK_PATH; do
        RESOLVED_PATH=$(realpath --canonicalize-missing -- "$LINK_PATH")
        case "$RESOLVED_PATH" in
            "$SOURCE_DIR"|"$SOURCE_DIR"/*) ;;
            *)
                echo "Archive link escapes extraction directory: $LINK_PATH" >&2
                exit 1
                ;;
        esac
    done < <(find "$SOURCE_DIR" -type l -print0)
}

check_package_files() {
    local REQUIRED

    for REQUIRED in bin/codex bin/codex-code-mode-host codex-package.json; do
        if [[ ! -f "$SOURCE_DIR/$REQUIRED" ]]; then
            echo "ERROR: Unexpected Codex archive layout: Missing $REQUIRED at $SOURCE_DIR" >&2
            exit 1
        fi
    done
    if ! jq --exit-status --arg VERSION "$UPSTREAM_VERSION" \
        '.version | tostring | startswith($VERSION)' \
        "$SOURCE_DIR/codex-package.json" >/dev/null; then
        echo "Package metadata version mismatch: expected $UPSTREAM_VERSION" >&2
        exit 1
    fi
    if ! jq --exit-status '.entrypoint == "bin/codex"' \
        "$SOURCE_DIR/codex-package.json" >/dev/null; then
        echo 'Unexpected package entrypoint' >&2
        exit 1
    fi
}

extract_package() {
    check_member_types

    mkdir -p "$SOURCE_DIR"
    SOURCE_DIR=$(realpath -- "$SOURCE_DIR")
    # Use tar's path protections; never enable absolute names or dereferencing.
    tar --extract --gzip --file "$ARCHIVE_PATH" --directory "$SOURCE_DIR" \
        --no-same-owner --no-same-permissions --keep-old-files

    check_links
    # Keep owner access; remove group/other write and setuid/setgid/sticky bits.
    chmod -R u+rwX,go-w,a-s,a-t "$SOURCE_DIR"
    check_package_files
}

# Read the download selected by the query hook.
ASSET=$(jq --compact-output --exit-status --arg ARCH "$ARCHITECTURE" \
    '.[$ARCH]' "$WORKSPACE/assets.json")

UPSTREAM_VERSION=$(jq --raw-output --exit-status '.version | strings' <<< "$ASSET")
ASSET_NAME=$(jq --raw-output --exit-status '.name | strings' <<< "$ASSET")
DOWNLOAD_URL=$(jq --raw-output --exit-status '.url | strings' <<< "$ASSET")
ARCHIVE_SHA256=$(jq --raw-output --exit-status '.sha256 | strings' <<< "$ASSET")

if [[ "$UPSTREAM_VERSION" != "${PACKAGE_VERSION%-*}" ]]; then
    echo 'Inconsistent Codex build version' >&2
    exit 1
fi
ARCHIVE_PATH="$WORKSPACE/$ASSET_NAME"

verify_download "$DOWNLOAD_URL" "$ARCHIVE_PATH" "$ARCHIVE_SHA256" refresh
extract_package

PACKAGE_DIR="$WORKSPACE/pkg-$ARCHITECTURE"
PACKAGE_ROOT="$PACKAGE_DIR/usr/lib/openai-codex"
mkdir -p "$PACKAGE_ROOT" "$PACKAGE_DIR/usr/bin" "$PACKAGE_DIR/DEBIAN"
cp -a "$SOURCE_DIR/." "$PACKAGE_ROOT/"

# Keep upstream relative paths while using distro-managed tools.
rm -f "$PACKAGE_ROOT/codex-resources/bwrap" "$PACKAGE_ROOT/codex-path/rg"
mkdir -p "$PACKAGE_ROOT/codex-resources" "$PACKAGE_ROOT/codex-path"
printf '%s\n' '#!/bin/sh' 'exec /usr/bin/bwrap "$@"' > "$PACKAGE_ROOT/codex-resources/bwrap"
printf '%s\n' '#!/bin/sh' 'exec /usr/bin/rg "$@"' > "$PACKAGE_ROOT/codex-path/rg"
chmod 755 "$PACKAGE_ROOT/codex-resources/bwrap" "$PACKAGE_ROOT/codex-path/rg"
chmod 755 "$PACKAGE_ROOT/bin/codex" "$PACKAGE_ROOT/bin/codex-code-mode-host"
for BINARY in "$PACKAGE_ROOT"/bin/*; do
    [[ -f "$BINARY" && -x "$BINARY" ]] || continue
    BINARY_NAME=$(basename "$BINARY")
    ln -s "../lib/openai-codex/bin/$BINARY_NAME" "$PACKAGE_DIR/usr/bin/$BINARY_NAME"
done

render_control "$ADAPTER_DIR/control.in" "$PACKAGE_DIR" \
    ARCHITECTURE "$ARCHITECTURE"

build_deb "$PACKAGE_DIR" "$OUTPUT"
