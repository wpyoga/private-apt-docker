#!/bin/bash
set -Eeuo pipefail

: "${ADAPTER_DIR:?ADAPTER_DIR must be set and non-empty}"
: "${WORKSPACE:?WORKSPACE must be set and non-empty}"
: "${ARCHES:?ARCHES must be set and non-empty}"

curl -fLsS --retry 3 \
    -H 'Accept: application/vnd.github+json' \
    -H 'User-Agent: private-apt-publisher' \
    https://api.github.com/repos/openai/codex/releases/latest \
    -o "$WORKSPACE/release.json"

python3 "$ADAPTER_DIR/release.py" "$WORKSPACE" "$ARCHES"
