#!/bin/bash
set -Eeuo pipefail
shopt -s nullglob

: "${ADAPTER_DIR:?ADAPTER_DIR must be set and non-empty}"
: "${WORKSPACE:?WORKSPACE must be set and non-empty}"
: "${PUBLISHER_STREAM:?PUBLISHER_STREAM must be set and non-empty}"
: "${BUILD_INPUTS_SHA256:?BUILD_INPUTS_SHA256 must be set and non-empty}"
: "${MAINTAINER:?MAINTAINER must be set and non-empty}"

PACKAGE_VERSION=${1:?Package version is required}
ARCHITECTURE=${2:?Architecture is required}
OUTPUT_DIR=${3:?Output directory is required}
case "$ARCHITECTURE" in
    amd64)
        MULTIARCH=x86_64-linux-gnu
        INTERPRETER=/lib64/ld-linux-x86-64.so.2
        ;;
    arm64)
        MULTIARCH=aarch64-linux-gnu
        INTERPRETER=/lib/ld-linux-aarch64.so.1
        ;;
    *) echo "[gimp-3.2] Unsupported architecture: $ARCHITECTURE" >&2; exit 1 ;;
esac

ASSET=$(jq --compact-output --exit-status --arg ARCH "$ARCHITECTURE" \
    '.[$ARCH] | objects' "$WORKSPACE/assets.json")
UPSTREAM_VERSION=$(jq --raw-output --exit-status '.version | strings' <<< "$ASSET")
if [[ "$UPSTREAM_VERSION" != "${PACKAGE_VERSION%-*}" || ! "$UPSTREAM_VERSION" =~ ^3\.2\.[0-9]+$ ]]; then
    echo "[gimp-3.2] Inconsistent selected version for $PACKAGE_VERSION $ARCHITECTURE" >&2
    exit 1
fi
DOWNLOAD_URL=$(jq --raw-output --exit-status '.url | strings' <<< "$ASSET")
DOWNLOAD_SHA256=$(jq --raw-output --exit-status '.sha256 | strings' <<< "$ASSET")
ARCHIVE="$WORKSPACE/gimp-$ARCHITECTURE.AppImage"
SOURCE_DIR="$WORKSPACE/source-$ARCHITECTURE"
SOURCE_USR="$SOURCE_DIR/usr"
STAGING_DIR="$WORKSPACE/staging-$ARCHITECTURE"
PRIVATE_PATH="/usr/lib/$MULTIARCH/gimp/bundled"
export SOURCE_USR STAGING_DIR MULTIARCH UPSTREAM_VERSION ARCHITECTURE

if [[ ! -f "$ARCHIVE" ]]; then
    curl -fLsS --retry 3 "$DOWNLOAD_URL" -o "$ARCHIVE"
fi
printf '%s  %s\n' "$DOWNLOAD_SHA256" "$ARCHIVE" | sha256sum --check
if [[ -e "$SOURCE_DIR" || -e "$STAGING_DIR" ]]; then
    echo "[gimp-3.2] Refusing to reuse extraction or staging tree for $ARCHITECTURE" >&2
    exit 1
fi
OFFSET=$(python3 "$ADAPTER_DIR/inspect-bundle.py" offset "$ARCHIVE")
# Extract data directly. Never execute AppRun, the AppImage runtime, or target ELF.
unsquashfs -no-progress -no-xattrs -processors 1 -o "$OFFSET" \
    -d "$SOURCE_DIR" "$ARCHIVE" \
    usr/bin/gimp-3.2 usr/bin/gimp-console-3.2 usr/bin/gimp-script-fu-interpreter-3.0 \
    usr/bin/gimptool-3.2 usr/include/gimp-3.0 usr/include/babl-0.1 usr/include/gegl-0.4 \
    usr/libexec/gimp-debug-tool-3.2 \
    "usr/lib/$MULTIARCH/gimp" "usr/lib/$MULTIARCH/babl-0.1" "usr/lib/$MULTIARCH/gegl-0.4" \
    "usr/lib/$MULTIARCH/libgimp*.so*" "usr/lib/$MULTIARCH/libbabl*.so*" \
    "usr/lib/$MULTIARCH/libgegl*.so*" "usr/lib/$MULTIARCH/girepository-1.0/Gimp*.typelib" \
    "usr/lib/$MULTIARCH/girepository-1.0/Babl-0.1.typelib" \
    "usr/lib/$MULTIARCH/girepository-1.0/Gegl-0.4.typelib" \
    "usr/lib/$MULTIARCH/pkgconfig/gimp-3.0.pc" "usr/lib/$MULTIARCH/pkgconfig/babl-0.1.pc" \
    "usr/lib/$MULTIARCH/pkgconfig/gimpui-3.0.pc" "usr/lib/$MULTIARCH/pkgconfig/gimpthumb-3.0.pc" \
    "usr/lib/$MULTIARCH/pkgconfig/gegl-0.4.pc" \
    usr/etc/gimp usr/share/gimp usr/share/icons usr/share/locale \
    usr/share/applications/org.gimp.GIMP.Stable.desktop \
    usr/share/metainfo/org.gimp.GIMP.Stable.appdata.xml
python3 "$ADAPTER_DIR/inspect-bundle.py" source
bash "$ADAPTER_DIR/stage.sh"

DOC_NAME="gimp-api-docs-$UPSTREAM_VERSION.tar.xz"
DOC_ARCHIVE="$WORKSPACE/$DOC_NAME"
if [[ ! -f "$DOC_ARCHIVE" ]]; then
    curl -fLsS --retry 3 "https://download.gimp.org/gimp/v3.2/api-docs/$DOC_NAME" -o "$DOC_ARCHIVE"
fi
printf '%s  %s\n' "$(cat "$WORKSPACE/api-docs.sha256")" "$DOC_ARCHIVE" | sha256sum --check
python3 "$ADAPTER_DIR/inspect-docs.py" "$DOC_ARCHIVE" "$UPSTREAM_VERSION"
DOC_DIR="$STAGING_DIR/libgimp-3.0-doc/usr/share/doc/libgimp-3.0-doc"
mkdir -p "$DOC_DIR"
tar --extract --xz --file "$DOC_ARCHIVE" --strip-components=1 \
    --no-same-owner --no-same-permissions --directory "$DOC_DIR"
python3 "$ADAPTER_DIR/inspect-bundle.py" staged

while IFS= read -r -d '' BINARY; do
    if patchelf --print-interpreter "$BINARY" >/dev/null 2>&1; then
        patchelf --set-interpreter "$INTERPRETER" "$BINARY"
    fi
    patchelf --set-rpath "\$ORIGIN:$PRIVATE_PATH" "$BINARY"
done < "$WORKSPACE/elf-$ARCHITECTURE.paths0"

RUNTIME_DEPENDS=$(
    awk -F '|' '!/^#/ && NF == 3 && $3 == "runtime" { print $1 }' "$ADAPTER_DIR/runtime-dependencies" \
        | sort -u | paste -sd,
)
APPLICATION_DEPENDS=$(awk -F '|' '!/^#/ && NF == 3 && $3 == "gimp" { print $1 }' \
    "$ADAPTER_DIR/runtime-dependencies" | sort -u | paste -sd,)
MAINTAINER_SED=$(printf '%s' "$MAINTAINER" | sed 's/[\\&|]/\\&/g')

for PACKAGE_NAME in gimp gimp-data libgimp-3.0-0 gir1.2-gimp-3.0 gimp-bundled-runtime \
    libgimp-3.0-bin libgimp-3.0-dev libgimp-3.0-doc; do
    PACKAGE_DIR="$STAGING_DIR/$PACKAGE_NAME"
    DEPENDS="gimp-bundled-runtime (= $PACKAGE_VERSION)"
    PROVIDES=
    SUGGESTS=
    PACKAGE_ARCHITECTURE="$ARCHITECTURE"
    case "$PACKAGE_NAME" in
        gimp)
            DEPENDS+=", gimp-data (= $PACKAGE_VERSION), libgimp-3.0-0 (= $PACKAGE_VERSION)"
            DEPENDS+=", gir1.2-gimp-3.0 (= $PACKAGE_VERSION), $APPLICATION_DEPENDS"
            SUGGESTS='Suggests: gimp-data-extras, gimp-help-en | gimp-help'
            ;;
        gimp-data) DEPENDS=hicolor-icon-theme ;;
        gimp-bundled-runtime) DEPENDS="$RUNTIME_DEPENDS" ;;
        gir1.2-gimp-3.0)
            DEPENDS="libgimp-3.0-0 (= $PACKAGE_VERSION), gimp-bundled-runtime (= $PACKAGE_VERSION)"
            PROVIDES="Provides: gir1.2-gimpui-3.0 (= $PACKAGE_VERSION)"
            ;;
        libgimp-3.0-bin)
            DEPENDS="libgimp-3.0-0 (= $PACKAGE_VERSION), libglib2.0-0t64, libc6"
            ;;
        libgimp-3.0-dev)
            DEPENDS="libgimp-3.0-0 (= $PACKAGE_VERSION), gir1.2-gimp-3.0 (= $PACKAGE_VERSION)"
            DEPENDS+=", libgimp-3.0-bin (= $PACKAGE_VERSION), gimp-bundled-runtime (= $PACKAGE_VERSION)"
            DEPENDS+=", libgtk-3-dev (>= 3.22.29), libgexiv2-dev (>= 0.14.0), libjson-glib-dev, liblcms2-dev, pkgconf"
            SUGGESTS='Suggests: libgimp-3.0-doc'
            ;;
        libgimp-3.0-doc)
            DEPENDS=
            PACKAGE_ARCHITECTURE=all
            ;;
    esac
    mkdir -p "$PACKAGE_DIR/DEBIAN" "$PACKAGE_DIR/usr/share/doc/$PACKAGE_NAME"
    sed -e "s/@UPSTREAM_VERSION@/$UPSTREAM_VERSION/g" \
        "$ADAPTER_DIR/copyright.in" > "$PACKAGE_DIR/usr/share/doc/$PACKAGE_NAME/copyright"
    jq --raw-output 'to_entries[] | "\(.key): \(.value)"' \
        "$WORKSPACE/bundle-versions-$ARCHITECTURE.json" \
        > "$PACKAGE_DIR/usr/share/doc/$PACKAGE_NAME/upstream-versions"
    if [[ -d "$PACKAGE_DIR/etc" ]]; then
        find "$PACKAGE_DIR/etc" -type f -printf '/etc/%P\n' \
            | sort > "$PACKAGE_DIR/DEBIAN/conffiles"
    fi
    if [[ "$PACKAGE_NAME" == libgimp-3.0-0 ]]; then
        printf 'activate-noawait ldconfig\n' > "$PACKAGE_DIR/DEBIAN/triggers"
    fi
    # Finish delayed allocation before measuring the final staged tree.
    sync -f "$PACKAGE_DIR"
    INSTALLED_SIZE=$(du --summarize --block-size=1024 --exclude=DEBIAN "$PACKAGE_DIR" | cut -f1)
    SUGGESTS_SED=$(printf '%s' "$SUGGESTS" | sed 's/[\\&|]/\\&/g')
    sed \
        -e "s|@MAINTAINER@|$MAINTAINER_SED|g" \
        -e "s/@PACKAGE_NAME@/$PACKAGE_NAME/g" \
        -e "s/@PACKAGE_VERSION@/$PACKAGE_VERSION/g" \
        -e "s/@ARCHITECTURE@/$PACKAGE_ARCHITECTURE/g" \
        -e "s/@INSTALLED_SIZE@/$INSTALLED_SIZE/g" \
        -e "s|@DEPENDS@|$DEPENDS|g" \
        -e "s|@PROVIDES@|$PROVIDES|g" \
        -e "s|@SUGGESTS@|$SUGGESTS_SED|g" \
        -e "s/@BUILD_INPUTS_SHA256@/$BUILD_INPUTS_SHA256/g" \
        -e "s/@PUBLISHER_STREAM@/$PUBLISHER_STREAM/g" \
        -e '/^$/d' -e '/^Depends: $/d' \
        "$ADAPTER_DIR/control.in" > "$PACKAGE_DIR/DEBIAN/control"
    dpkg-deb --build --root-owner-group -Zgzip "$PACKAGE_DIR" \
        "$OUTPUT_DIR/${PACKAGE_NAME}_${PACKAGE_VERSION}_${PACKAGE_ARCHITECTURE}.deb"
done

bash "$ADAPTER_DIR/build-help" "$PACKAGE_VERSION" "$ARCHITECTURE" "$OUTPUT_DIR"
