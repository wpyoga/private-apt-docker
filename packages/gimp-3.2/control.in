Package: @PACKAGE_NAME@
Version: @PACKAGE_VERSION@
Architecture: @ARCHITECTURE@
Maintainer: @MAINTAINER@
Section: graphics
Priority: optional
Homepage: https://www.gimp.org/
Installed-Size: @INSTALLED_SIZE@
Depends: @DEPENDS@
@PROVIDES@
@SUGGESTS@
