#!/bin/bash
set -Eeuo pipefail

: "${FRAMEWORK_DIR:?FRAMEWORK_DIR must be set and non-empty}"
: "${WORKSPACE:?WORKSPACE must be set and non-empty}"
: "${ARCHES:?ARCHES must be set and non-empty}"
source "$FRAMEWORK_DIR/lib/adapter/github.sh"

fetch_github_release herdrdev/herdr "$WORKSPACE/release.json"
TAG=$(jq --raw-output --exit-status '.tag_name | strings' "$WORKSPACE/release.json")
if [[ ! "$TAG" =~ ^v([0-9]+\.[0-9]+\.[0-9]+)$ ]]; then
    echo "[herdr] Unexpected stable release tag: $TAG" >&2
    exit 1
fi
UPSTREAM_VERSION="${BASH_REMATCH[1]}"
record_github_release_date "$WORKSPACE/release.json" "$WORKSPACE/release-date"
printf '{}\n' > "$WORKSPACE/assets.json"
: > "$WORKSPACE/targets.tsv"

for ARCHITECTURE in $ARCHES; do
    case "$ARCHITECTURE" in
        amd64) UPSTREAM_ARCH=x86_64 ;;
        arm64) UPSTREAM_ARCH=aarch64 ;;
        *) echo "[herdr] Unsupported architecture: $ARCHITECTURE" >&2; exit 1 ;;
    esac

    NAME="herdr-linux-$UPSTREAM_ARCH"
    ASSET=$(select_github_asset "$WORKSPACE/release.json" "$NAME")
    if [[ -z "$ASSET" ]]; then
        echo "WARNING: [herdr] No upstream binary for $TAG ($ARCHITECTURE)" >&2
        continue
    fi
    VERSION="$UPSTREAM_VERSION"
    jq --arg ARCH "$ARCHITECTURE" --arg VERSION "$VERSION" --argjson ASSET "$ASSET" '
        .[$ARCH] = {version: $VERSION, url: $ASSET.browser_download_url,
                    sha256: ($ASSET.digest | ltrimstr("sha256:") | ascii_downcase)}
    ' "$WORKSPACE/assets.json" > "$WORKSPACE/assets.tmp"
    mv -- "$WORKSPACE/assets.tmp" "$WORKSPACE/assets.json"
    printf '%s\t%s\n' "$VERSION" "$ARCHITECTURE" >> "$WORKSPACE/targets.tsv"
done
