#!/bin/bash
set -Eeuo pipefail

: "${ADAPTER_DIR:?ADAPTER_DIR must be set and non-empty}"
: "${WORKSPACE:?WORKSPACE must be set and non-empty}"
: "${ARCHES:?ARCHES must be set and non-empty}"
: "${BINARY_PACKAGES:?BINARY_PACKAGES must be set and non-empty}"

# Only read sid metadata. Clients and the build host keep their existing APT sources.
curl -fLsS --retry 3 https://deb.debian.org/debian/dists/sid/main/binary-amd64/Packages.xz \
    -o "$WORKSPACE/Packages.xz"
python3 "$ADAPTER_DIR/metadata.py" query
