#!/bin/bash
set -Eeuo pipefail

: "${FRAMEWORK_DIR:?FRAMEWORK_DIR must be set and non-empty}"
source "$FRAMEWORK_DIR/lib/adapter/github.sh"

: "${ADAPTER_DIR:?ADAPTER_DIR must be set and non-empty}"
: "${WORKSPACE:?WORKSPACE must be set and non-empty}"
: "${ARCHES:?ARCHES must be set and non-empty}"

RELEASE_FILE="$WORKSPACE/release.json"
ASSETS_FILE="$WORKSPACE/assets.json"
TARGETS_FILE="$WORKSPACE/targets.tsv"

query_release() {
    fetch_github_release mkasberg/ghostty-ubuntu "$RELEASE_FILE"

    TAG=$(jq --raw-output --exit-status '.tag_name | strings' "$RELEASE_FILE")
    if [[ ! "$TAG" =~ ^([0-9]+\.[0-9]+\.[0-9]+)-([0-9]+)-(ppa[0-9]+)$ ]]; then
        echo "[ghostty] Unexpected release tag: $TAG" >&2
        exit 1
    fi
    RELEASE_VERSION="${BASH_REMATCH[1]}"
    DEBIAN_REVISION="${BASH_REMATCH[2]}"
    COMMUNITY_REVISION="${BASH_REMATCH[3]}"

    # Keep community rebuilds in our tracked version, separate from our revision.
    ASSET_VERSION="$RELEASE_VERSION-$DEBIAN_REVISION.$COMMUNITY_REVISION"
    VERSION="$RELEASE_VERSION+$DEBIAN_REVISION.$COMMUNITY_REVISION"
    DEB_VERSION="$RELEASE_VERSION-$DEBIAN_REVISION~$COMMUNITY_REVISION"

    record_github_release_date "$RELEASE_FILE" "$WORKSPACE/release-date"
}

select_assets() {
    local ARCHITECTURE ASSET_NAME ASSET

    printf '{}\n' > "$ASSETS_FILE"
    : > "$TARGETS_FILE"

    for ARCHITECTURE in $ARCHES; do
        case "$ARCHITECTURE" in
            amd64|arm64) ;;
            *)
                echo "[ghostty] Unsupported architecture: $ARCHITECTURE" >&2
                exit 1
                ;;
        esac
        ASSET_NAME="ghostty_${ASSET_VERSION}_${ARCHITECTURE}_trixie.deb"
        ASSET=$(select_github_asset "$RELEASE_FILE" "$ASSET_NAME")
        if [[ -z "$ASSET" ]]; then
            echo "WARNING: [ghostty] No upstream package for $ARCHITECTURE: $ASSET_NAME" >&2
            continue
        fi

        # Keep the metadata indexed by Debian architecture for the build hook.
        jq \
            --arg ARCH "$ARCHITECTURE" \
            --arg VERSION "$VERSION" \
            --arg DEB_VERSION "$DEB_VERSION" \
            --argjson ASSET "$ASSET" '
            .[$ARCH] = {
                version: $VERSION,
                deb_version: $DEB_VERSION,
                name: $ASSET.name,
                url: $ASSET.browser_download_url,
                sha256: ($ASSET.digest | ltrimstr("sha256:"))
            }
        ' "$ASSETS_FILE" > "$WORKSPACE/assets.tmp"
        mv -- "$WORKSPACE/assets.tmp" "$ASSETS_FILE"

        printf '%s\t%s\n' "$VERSION" "$ARCHITECTURE" >> "$TARGETS_FILE"
    done
}

query_release
select_assets
