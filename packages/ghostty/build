#!/bin/bash
set -Eeuo pipefail

: "${FRAMEWORK_DIR:?FRAMEWORK_DIR must be set and non-empty}"
source "$FRAMEWORK_DIR/lib/adapter/package.sh"

: "${ADAPTER_DIR:?ADAPTER_DIR must be set and non-empty}"
: "${WORKSPACE:?WORKSPACE must be set and non-empty}"
: "${PUBLISHER_STREAM:?PUBLISHER_STREAM must be set and non-empty}"
: "${BUILD_INPUTS_SHA256:?BUILD_INPUTS_SHA256 must be set and non-empty}"
: "${MAINTAINER:?MAINTAINER must be set and non-empty}"

PACKAGE_VERSION="$1"
ARCHITECTURE="$2"
OUTPUT_DIR="$3"
DOWNLOAD_PATH="$WORKSPACE/ghostty-$ARCHITECTURE.deb"
PACKAGE_DIR="$WORKSPACE/pkg-$ARCHITECTURE"
OUTPUT_PATH="$OUTPUT_DIR/ghostty_${PACKAGE_VERSION}_${ARCHITECTURE}.deb"

read_selected_asset() {
    local ASSET EXPECTED_VERSION

    ASSET=$(jq --compact-output --exit-status --arg ARCH "$ARCHITECTURE" \
        '.[$ARCH]' "$WORKSPACE/assets.json")
    UPSTREAM_VERSION=$(jq --raw-output --exit-status '.version | strings' <<< "$ASSET")
    DEB_VERSION=$(jq --raw-output --exit-status '.deb_version | strings' <<< "$ASSET")
    DOWNLOAD_URL=$(jq --raw-output --exit-status '.url | strings' <<< "$ASSET")
    DOWNLOAD_SHA256=$(jq --raw-output --exit-status '.sha256 | strings' <<< "$ASSET")

    EXPECTED_VERSION="${PACKAGE_VERSION%-*}"
    if [[ "$UPSTREAM_VERSION" != "$EXPECTED_VERSION" ]]; then
        printf '[ghostty] Build %s (%s): expected selected version %s, got %s\n' \
            "$PACKAGE_VERSION" "$ARCHITECTURE" "$EXPECTED_VERSION" "$UPSTREAM_VERSION" >&2
        exit 1
    fi
}

download_package() {
    verify_download "$DOWNLOAD_URL" "$DOWNLOAD_PATH" "$DOWNLOAD_SHA256" refresh
}

check_package_files() {
    local REQUIRED_PATH
    local REQUIRED_PATHS=(
        usr/bin/ghostty
        usr/share/applications/com.mitchellh.ghostty.desktop
        usr/share/terminfo/x/xterm-ghostty
    )

    for REQUIRED_PATH in "${REQUIRED_PATHS[@]}"; do
        if [[ ! -f "$PACKAGE_DIR/$REQUIRED_PATH" ]]; then
            printf '[ghostty] %s (%s): unexpected package layout; Missing %s in %s\n' \
                "$PACKAGE_VERSION" "$ARCHITECTURE" "$REQUIRED_PATH" "$PACKAGE_DIR" >&2
            exit 1
        fi
    done
}

repackage() {
    local INSTALLED_SIZE

    # Preserve upstream dependencies and integration without running its scripts.
    dpkg-deb --raw-extract "$DOWNLOAD_PATH" "$PACKAGE_DIR"
    check_package_files

    # Recalculate after staging; upstream metadata may be missing or outdated.
    INSTALLED_SIZE=$(installed_size "$PACKAGE_DIR")
    python3 "$FRAMEWORK_DIR/lib/adapter/rewrite-control.py" \
        "$PACKAGE_DIR/DEBIAN/control" "$PACKAGE_VERSION" "$INSTALLED_SIZE"
    build_deb "$PACKAGE_DIR" "$OUTPUT_PATH"
}

read_selected_asset
download_package
check_deb_field "$DOWNLOAD_PATH" Package ghostty
check_deb_field "$DOWNLOAD_PATH" Version "$DEB_VERSION"
check_deb_field "$DOWNLOAD_PATH" Architecture "$ARCHITECTURE"
repackage
