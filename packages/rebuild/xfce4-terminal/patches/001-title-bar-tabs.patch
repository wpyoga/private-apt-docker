+/* The strip is a presentation of this notebook; all terminal operations stay
+ * here so close confirmations, session ownership and action settings are shared. */
+static void
+terminal_window_update_titlebar_tabs (TerminalWindow *window)
+{
+  if (window->priv->drop_down)
+    return;
+  gboolean was_active = terminal_titlebar_tabs_active (window);
+  gboolean enabled;
+  g_object_get (window->priv->preferences, "misc-titlebar-tabs", &enabled, NULL);
+  if (!enabled && !was_active)
+    return;
+  GdkWindow *gdk_window = gtk_widget_get_window (GTK_WIDGET (window));
+  gboolean normal = gdk_window != NULL
+                    && !(gdk_window_get_state (gdk_window)
+                         & (GDK_WINDOW_STATE_MAXIMIZED | GDK_WINDOW_STATE_FULLSCREEN | WINDOW_STATE_TILED));
+  if (normal)
+    terminal_window_size_push (window);
+  terminal_titlebar_tabs_update (window);
+  if (was_active != terminal_titlebar_tabs_active (window))
+    {
+      gtk_notebook_set_show_tabs (GTK_NOTEBOOK (window->priv->notebook),
+                                 terminal_window_notebook_tabs_visible (window));
+      if (window->priv->active != NULL)
+        terminal_window_notify_title (window->priv->active, NULL, window);
+      if (window->priv->title_popover != NULL)
+        gtk_popover_popdown (GTK_POPOVER (window->priv->title_popover));
+      if (normal)
+        terminal_window_size_pop (window);
+    }
+}
+
+void
+terminal_window_tab_new (TerminalWindow *window)
+{
+  terminal_window_action_new_tab (window);
+}
+
+void
+terminal_window_tab_select (TerminalWindow *window,
+                            TerminalScreen *screen,
+                            guint32 time)
+{
+  gint page = gtk_notebook_page_num (GTK_NOTEBOOK (window->priv->notebook), GTK_WIDGET (screen));
+  if (page < 0)
+    return;
+  gtk_notebook_set_current_page (GTK_NOTEBOOK (window->priv->notebook), page);
+  gtk_window_present_with_time (GTK_WINDOW (window), time);
+  terminal_screen_focus (screen);
+}
+
+void
+terminal_window_tab_transfer (TerminalWindow *source,
+                              TerminalWindow *target,
+                              TerminalScreen *screen,
+                              gint position)
+{
+  if (source == target)
+    {
+      gtk_notebook_reorder_child (GTK_NOTEBOOK (source->priv->notebook), GTK_WIDGET (screen), position);
+      return;
+    }
+  g_object_ref (source);
+  g_object_ref (target);
+  g_object_ref (screen);
+  gtk_notebook_detach_tab (GTK_NOTEBOOK (source->priv->notebook), GTK_WIDGET (screen));
+  terminal_window_add (target, screen);
+  gtk_notebook_reorder_child (GTK_NOTEBOOK (target->priv->notebook), GTK_WIDGET (screen), position);
+  g_object_unref (screen);
+  g_object_unref (target);
+  g_object_unref (source);
+}
+
+void
+terminal_window_tab_drop_outside (TerminalWindow *window,
+                                  TerminalScreen *screen,
+                                  gint x,
+                                  gint y)
+{
+  if (gtk_notebook_get_n_pages (GTK_NOTEBOOK (window->priv->notebook)) == 1)
+    gtk_window_move (GTK_WINDOW (window), x, y);
+  else
+    terminal_window_notebook_create_window (GTK_NOTEBOOK (window->priv->notebook), GTK_WIDGET (screen), x, y, window);
+}
+
+void
+terminal_window_titlebar_anchor (TerminalWindow *window,
+                                GtkWidget *anchor,
+                                gboolean visible,
+                                gint height)
+{
+  gint requested_height;
+  gtk_widget_get_size_request (anchor, NULL, &requested_height);
+  if (gtk_widget_get_visible (anchor) == visible
+      && (!visible || requested_height == height))
+    return;
+  terminal_window_size_push (window);
+  gtk_widget_set_size_request (anchor, -1, height);
+  gtk_widget_set_visible (anchor, visible);
+  terminal_window_size_pop (window);
+}
