commit aac4b9273f374d9cdb383c04fcf1230482e3e98d
Author: William Poetra Yoga <william.poetra@gmail.com>
Date:   Sun Nov 1 00:40:16 2026 +0700

    Allow Shift-Enter to input a newline instead of the default Enter key event
    
    Shift-Enter is useful when using TUI apps that present a multi-line text box.
    For example: Codex CLI, Claude Code. This allows the user to enter a newline
    in a text box without using Ctrl-J (which is a bit cumbersome). Also, other
    applications (like the browser) bind Ctrl-J to other actions, so repeated
    switching between the terminal and the browser leads to typing mistakes.

diff --git a/terminal/terminal-preferences-dialog.c b/terminal/terminal-preferences-dialog.c
index 29482116..ecd13aac 100644
--- a/terminal/terminal-preferences-dialog.c
+++ b/terminal/terminal-preferences-dialog.c
@@ -1434,6 +1434,29 @@ terminal_preferences_dialog_init (TerminalPreferencesDialog *dialog)
   /* next row */
   row++;
 
+  label = gtk_label_new_with_mnemonic (_("Shift+Enter generates:"));
+  gtk_label_set_xalign (GTK_LABEL (label), 0.0f);
+  gtk_grid_attach (GTK_GRID (grid), label, 0, row, 1, 1);
+  gtk_widget_show (label);
