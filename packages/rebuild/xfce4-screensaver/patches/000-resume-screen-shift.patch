         return;
 
-    gs_window_show_message (window, summary, body, icon);
+    summary = summary != NULL && *summary != '\0' ? summary : NULL;
+    body = body != NULL && *body != '\0' ? body : NULL;
+    icon = icon != NULL && *icon != '\0' ? icon : NULL;
