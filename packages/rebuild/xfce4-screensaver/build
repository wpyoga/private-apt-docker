#!/bin/bash
set -Eeuo pipefail

: "${FRAMEWORK_DIR:?FRAMEWORK_DIR must be set}"
: "${ADAPTER_DIR:?ADAPTER_DIR must be set}"
: "${WORKSPACE:?WORKSPACE must be set}"
source "$FRAMEWORK_DIR/lib/adapter/package.sh"

VERSION="$1"
ARCHITECTURE="$2"
OUTPUT_DIR="$3"

: "${MAINTAINER:?MAINTAINER must be set and non-empty}"
: "${XFCE_BUILD_ARCH:?Use the xfce4-screensaver toolchain image}"
if [[ "$ARCHITECTURE" != "$XFCE_BUILD_ARCH" ]]; then
    echo "xfce4-screensaver: requested $ARCHITECTURE but toolchain targets $XFCE_BUILD_ARCH" >&2
    exit 1
fi

SOURCE_VERSION=$(cat "$WORKSPACE/source-version")
DESCRIPTOR=$(cat "$WORKSPACE/source-descriptor")
SOURCE_DIR="$WORKSPACE/build-$ARCHITECTURE"
trap 'echo "ERROR: [xfce4-screensaver] $VERSION ($ARCHITECTURE) failed at line $LINENO; previous published packages remain available" >&2' ERR
[[ "${VERSION%-*}" == "$SOURCE_VERSION+local" ]]
case "$ARCHITECTURE" in amd64|arm64) ;; *) exit 1 ;; esac

dpkg-source -x "$DESCRIPTOR" "$SOURCE_DIR"
cd "$SOURCE_DIR"

export QUILT_PATCHES=debian/patches
while IFS= read -r PATCH || [[ -n "$PATCH" ]]; do
    [[ -z "$PATCH" || "$PATCH" == \#* ]] && continue
    if [[ "$PATCH" == /* || "$PATCH" == *..* || ! -f "$ADAPTER_DIR/patches/$PATCH" ]]; then
        echo "Invalid local patch: $PATCH" >&2
        exit 1
    fi
    quilt import "$ADAPTER_DIR/patches/$PATCH"
    quilt push --fuzz=0
done < "$ADAPTER_DIR/patches/series"

# Regenerate build files after local patches, retaining Debian's other rules.
if grep -Fq 'dh_auto_configure' debian/rules; then
    echo "xfce4-screensaver $SOURCE_VERSION: unexpected dh_auto_configure command in debian/rules" >&2
    exit 1
fi
cat "$ADAPTER_DIR/configure-rules.in" >> debian/rules

if [[ "$ARCHITECTURE" == arm64 ]]; then
    # This tool runs on the builder, rather than on the target architecture.
    if ! grep -Eq '^[[:space:]]+xfce4-dev-tools$' debian/control; then
        echo "xfce4-screensaver $SOURCE_VERSION: unexpected xfce4-dev-tools build dependency" >&2
        exit 1
    fi
    sed -i 's/xfce4-dev-tools$/xfce4-dev-tools:native/' debian/control
    export CC=aarch64-linux-gnu-gcc
fi

export DEBEMAIL="$MAINTAINER"
dch --newversion "$VERSION" --distribution trixie "Apply local patch series."
export DEB_BUILD_OPTIONS="nocheck parallel=2 noautodbgsym"
export DEB_BUILD_PROFILES="cross nocheck"
dpkg-buildpackage --build=binary --host-arch "$ARCHITECTURE" -us -uc

BUILT_PACKAGE="$WORKSPACE/xfce4-screensaver_${VERSION#*:}_${ARCHITECTURE}.deb"
check_deb_field "$BUILT_PACKAGE" Package xfce4-screensaver
check_deb_field "$BUILT_PACKAGE" Version "$VERSION"
check_deb_field "$BUILT_PACKAGE" Architecture "$ARCHITECTURE"

PACKAGE_DIR="$WORKSPACE/staged-$ARCHITECTURE"
dpkg-deb --raw-extract "$BUILT_PACKAGE" "$PACKAGE_DIR"
REQUIRED_PATHS=(
    usr/bin/xfce4-screensaver
    usr/bin/xfce4-screensaver-command
    usr/bin/xfce4-screensaver-preferences
    usr/libexec/xfce4-screensaver-dialog
    usr/share/applications/xfce4-screensaver-preferences.desktop
    usr/share/dbus-1/services/org.xfce.ScreenSaver.service
    etc/pam.d/xfce4-screensaver
    etc/xdg/autostart/xfce4-screensaver.desktop
)
for REQUIRED_PATH in "${REQUIRED_PATHS[@]}"; do
    if [[ ! -f "$PACKAGE_DIR/$REQUIRED_PATH" ]]; then
        echo "xfce4-screensaver $VERSION ($ARCHITECTURE): missing $REQUIRED_PATH" >&2
        exit 1
    fi
done

INSTALLED_SIZE=$(installed_size "$PACKAGE_DIR")
python3 "$FRAMEWORK_DIR/lib/adapter/rewrite-control.py" \
    "$PACKAGE_DIR/DEBIAN/control" "$VERSION" "$INSTALLED_SIZE"
build_deb "$PACKAGE_DIR" "$OUTPUT_DIR/xfce4-screensaver_${VERSION}_${ARCHITECTURE}.deb"
