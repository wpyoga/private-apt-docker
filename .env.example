# Copy to .env and edit the repository identity before running setup.
MAINTAINER="Your Name <you@example.com>"
REPO_NAME="Your Private APT Repository"
REPO_DESCRIPTION="Privately packaged Debian software"

CODENAME=trixie
ARCHES="amd64 arm64"
REPO_ARCHITECTURES="amd64 arm64"
CHECK_INTERVAL=21600

# Host-side setup settings.
REPO_USER=codexrepo
REPO_DATA_DIR=/srv/apt/codex
GPG_KEY_NAME="Repository Signing <repo@example.com>"
GPG_KEY_TYPE=ed25519
GPG_KEY_VALIDITY=20y

# Setup writes these values. Fill them in yourself for an existing deployment.
REPO_UID=
REPO_GID=
GPG_KEY=

# Repository outputs. REPO_DATA_DIR continues to hold the shared signing key.
REPACK_REPO_DIR=/srv/apt/codex/repo
REBUILD_REPO_DIR=/srv/apt/rebuild/repo
